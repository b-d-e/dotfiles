# ~/.dotfiles/ghostty/config  (symlinked to ~/.config/ghostty/config)

# Launch fish explicitly. This outranks the $SHELL env var, which GUI apps
# cache at login and which otherwise keeps opening the old shell until the
# next full logout. Path is macOS Homebrew; on Linux use
# /home/linuxbrew/.linuxbrew/bin/fish (or /usr/bin/fish).
command = /opt/homebrew/bin/fish --login --interactive

# Nerd Font so the starship prompt glyphs render (installed via the Brewfile
# on macOS / auto-downloaded on Linux by bootstrap.sh).
font-family = JetBrainsMono Nerd Font
font-size = 14

# Auto day/night: ghostty follows the OS light/dark appearance and swaps between
# these two themes live. eza + starship draw with the terminal's ANSI palette so
# they follow along; bat matches via bat/config (Catppuccin Latte/Mocha).
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
